  using lattice units in orthogonal box = (-6.075813 -6.075813 -6.075813) to (6.075813 6.075813 6.075813)
  create_atoms CPU = 0.011 seconds
create_atoms 0 random ${NMO} ${seed2} spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 #mon
create_atoms 0 random 475 ${seed2} spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 
create_atoms 0 random 475 6321 spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 
create_atoms 0 random 475 6321 spawn_box mol MO 6321 overlap 1.0 maxtry 5000 
