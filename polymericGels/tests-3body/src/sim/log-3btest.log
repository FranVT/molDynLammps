# Save atom positions with cluster id
dump dumpID all custom ${Ndump} ${Dir}/traj/${file5_name} id type x y z vx vy vz fx fy fz c_potAtom
dump dumpID all custom 1 ${Dir}/traj/${file5_name} id type x y z vx vy vz fx fy fz c_potAtom
dump dumpID all custom 1 /home/franvt/GitRepos/molDynLammps/polymericGels/tests-3body/data/2026-02-03-170509/traj/${file5_name} id type x y z vx vy vz fx fy fz c_potAtom
dump dumpID all custom 1 /home/franvt/GitRepos/molDynLammps/polymericGels/tests-3body/data/2026-02-03-170509/traj/traj_assembly.*.dumpf id type x y z vx vy vz fx fy fz c_potAtom
dump_modify dumpID pbc yes # remap atoms via periodic boundary conditions

# RUN SIMULATION

# Brownian Dynamics using Langevin Thermostat

timestep ${tstep}
timestep 0.00001

fix VelVerlet all nve # Use Velocity Verlet integrator

run ${steps}
run 2000
