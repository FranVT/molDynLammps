Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Dp", "=", "0.4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rc", "=", 
   RowBox[{"1.5", " ", "Dp"}]}], ";"}], "\n", 
 RowBox[{"u", "=", 
  RowBox[{"2", "\[Epsilon]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Dp", "/", "r"}], ")"}], "^", "4"}]}], "-", "1"}], 
    ")"}]}]}], "\n", 
 RowBox[{"v", "=", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"Dp", "/", 
     RowBox[{"(", 
      RowBox[{"r", "-", "rc"}], ")"}]}], "+", "2"}], "]"}]}], "\n", 
 RowBox[{"Upatch", "=", 
  RowBox[{"u", " ", "v"}]}]}], "Code",
