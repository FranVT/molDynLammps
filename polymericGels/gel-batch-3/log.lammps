LAMMPS (22 Jul 2025)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
package omp 0
using multi-threaded neighbor list subroutines
# Input Script of lammps for assembly simulation of polimeric gel network.
# Patchy particle script by Felipe Benavides: https://github.com/PipeB62/Hydrogel-Simulation
# Assembly protocolo based on: https://doi.org/10.1021/acs.macromol.7b01600
# Last Main modification: March 5, 2026 | Threebody interaction

# Initialization
units lj
dimension 3
boundary p p p

# Styles of atoms and that stuff
atom_style full
bond_style harmonic
angle_style harmonic
pair_style hybrid/overlay zero 0.0 lj/cut/omp ${r_cWCA} table/omp linear ${N_3body} threebody/table
pair_style hybrid/overlay zero 0.0 lj/cut/omp 1.12 table/omp linear ${N_3body} threebody/table
pair_style hybrid/overlay zero 0.0 lj/cut/omp 1.12 table/omp linear 128 threebody/table

newton on

# Create simulaiton box
region simulation_box block -$L $L -$L $L -$L $L
region simulation_box block -23.878436 $L -$L $L -$L $L
region simulation_box block -23.878436 23.878436 -$L $L -$L $L
region simulation_box block -23.878436 23.878436 -23.878436 $L -$L $L
region simulation_box block -23.878436 23.878436 -23.878436 23.878436 -$L $L
region simulation_box block -23.878436 23.878436 -23.878436 23.878436 -23.878436 $L
region simulation_box block -23.878436 23.878436 -23.878436 23.878436 -23.878436 23.878436
# N-atom-types region-ID keyword value Is necesesary the extra/special/per/atom (# of special neighbors per atom)
create_box 4 simulation_box     bond/types 1     angle/types 2     extra/bond/per/atom 10     extra/angle/per/atom 6     extra/special/per/atom 10
Created orthogonal box = (-23.878436 -23.878436 -23.878436) to (23.878436 23.878436 23.878436)
  2 by 2 by 2 MPI processor grid

# Atom types
mass 1 ${m_CP}      # CL
mass 1 1.0      
mass 2 ${m_CP}      # MO
mass 2 1.0      
mass 3 ${m_PT}      # PA (CL)
mass 3 1.0      
mass 4 ${m_PT}      # PB (MO)
mass 4 1.0      

# Coefficients
include src_lmp/potential.in
# Script with the pair-wise interaction and bonds between particles

bond_coeff 1 ${E_bondP} ${r_bondP}
bond_coeff 1 100.0 ${r_bondP}
bond_coeff 1 100.0 0.4
angle_coeff 1 ${E_bondP} ${theta_PB}
angle_coeff 1 100.0 ${theta_PB}
angle_coeff 1 100.0 180.0
angle_coeff 2 ${E_bondP} ${theta_PA}
angle_coeff 2 100.0 ${theta_PA}
angle_coeff 2 100.0 109.4712
pair_coeff 1 3 zero ${r_noInter}
pair_coeff 1 3 zero 0.5
pair_coeff 1 4 zero ${r_noInter}
pair_coeff 1 4 zero 0.5
pair_coeff 2 3 zero ${r_noInter}
pair_coeff 2 3 zero 0.5
pair_coeff 2 4 zero ${r_noInter}
pair_coeff 2 4 zero 0.5
pair_coeff 3 3 zero ${r_noInter}
pair_coeff 3 3 zero 0.5
pair_coeff 1 1 lj/cut/omp ${E_CP} ${r_CP} ${r_cWCA}
pair_coeff 1 1 lj/cut/omp 1.0 ${r_CP} ${r_cWCA}
pair_coeff 1 1 lj/cut/omp 1.0 1.0 ${r_cWCA}
pair_coeff 1 1 lj/cut/omp 1.0 1.0 1.12
pair_coeff 2 2 lj/cut/omp ${E_CP} ${r_CP} ${r_cWCA}
pair_coeff 2 2 lj/cut/omp 1.0 ${r_CP} ${r_cWCA}
pair_coeff 2 2 lj/cut/omp 1.0 1.0 ${r_cWCA}
pair_coeff 2 2 lj/cut/omp 1.0 1.0 1.12
pair_coeff 1 2 lj/cut/omp ${E_CP} ${r_CP} ${r_cWCA}
pair_coeff 1 2 lj/cut/omp 1.0 ${r_CP} ${r_cWCA}
pair_coeff 1 2 lj/cut/omp 1.0 1.0 ${r_cWCA}
pair_coeff 1 2 lj/cut/omp 1.0 1.0 1.12
pair_coeff 3 4 table/omp src_lmp/sysFiles/pachTab.table POT ${r_cPP} # sw/omp sysFiles/patchyPot.sw NULL NULL PA PB
pair_coeff 3 4 table/omp src_lmp/sysFiles/pachTab.table POT 0.6 
Reading pair table potential file src_lmp/sysFiles/pachTab.table with DATE: 2025-02-09
WARNING: 1 of 128 force values in table POT are inconsistent with -dE/dr.
WARNING:  Should only be flagged at inflection points (src/pair_table.cpp:469)
pair_coeff 4 4 table/omp src_lmp/sysFiles/pachTab.table POT ${r_cPP} # sw/omp sysFiles/patchyPot.sw NULL NULL PA PB
pair_coeff 4 4 table/omp src_lmp/sysFiles/pachTab.table POT 0.6 
Reading pair table potential file src_lmp/sysFiles/pachTab.table with DATE: 2025-02-09
WARNING: 1 of 128 force values in table POT are inconsistent with -dE/dr.
WARNING:  Should only be flagged at inflection points (src/pair_table.cpp:469)
pair_coeff * * threebody/table src_lmp/swapMech.3b NULL NULL PA PB
pair_modify pair lj/cut/omp shift yes


# Molecules
include src_lmp/molecules.in
# Script with all molecule information and create groups for computes

# Read the molecule information
molecule CL src_lmp/sysFiles/molecule.patchy.CL
Read molecule template CL:
# Patchy Cross-Linker
  1 molecules
  0 fragments
  0 bodies
  5 atoms with max type 3
  4 bonds with max type 1
  6 angles with max type 2
  0 dihedrals with max type 0
  0 impropers with max type 0
molecule MO src_lmp/sysFiles/molecule.patchy.MO
Read molecule template MO:
# Patchy Monomer
  1 molecules
  0 fragments
  0 bodies
  3 atoms with max type 4
  2 bonds with max type 1
  1 angles with max type 1
  0 dihedrals with max type 0
  0 impropers with max type 0

# Introduce the molecules
# ID style args keyword arg
region spawn_box block -$L $L -$L $L -$L $L
region spawn_box block -23.878436 $L -$L $L -$L $L
region spawn_box block -23.878436 23.878436 -$L $L -$L $L
region spawn_box block -23.878436 23.878436 -23.878436 $L -$L $L
region spawn_box block -23.878436 23.878436 -23.878436 23.878436 -$L $L
region spawn_box block -23.878436 23.878436 -23.878436 23.878436 -23.878436 $L
region spawn_box block -23.878436 23.878436 -23.878436 23.878436 -23.878436 23.878436

# create_atoms type style args keyword values
# style_random: N seed region-ID
# keyword_mol: template-ID seed
# keyword_overlap: overlap value = only insert if at least this distance from all existing atoms
# keyword_maxtry: maxtry value = number of attempts to insert a particle before failure
create_atoms 0 random ${N_pCL} ${seed1} spawn_box mol CL ${seed1} overlap 1.0 maxtry 5000 #xls
create_atoms 0 random 1000 ${seed1} spawn_box mol CL ${seed1} overlap 1.0 maxtry 5000 
create_atoms 0 random 1000 78 spawn_box mol CL ${seed1} overlap 1.0 maxtry 5000 
create_atoms 0 random 1000 78 spawn_box mol CL 78 overlap 1.0 maxtry 5000 
Created 5000 atoms
  using lattice units in orthogonal box = (-23.878436 -23.878436 -23.878436) to (23.878436 23.878436 23.878436)
  create_atoms CPU = 0.062 seconds
create_atoms 0 random ${N_pMO} ${seed2} spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 #mon
create_atoms 0 random 1000 ${seed2} spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 
create_atoms 0 random 1000 79 spawn_box mol MO ${seed2} overlap 1.0 maxtry 5000 
create_atoms 0 random 1000 79 spawn_box mol MO 79 overlap 1.0 maxtry 5000 
Created 3000 atoms
  using lattice units in orthogonal box = (-23.878436 -23.878436 -23.878436) to (23.878436 23.878436 23.878436)
  create_atoms CPU = 0.088 seconds

# Create groups for computes
group CrossLinker type 1 3
5000 atoms in group CrossLinker
group Monomer type 2 4
3000 atoms in group Monomer
group Patches type 3 4
6000 atoms in group Patches
group CL type 1
1000 atoms in group CL
group MO type 2
1000 atoms in group MO
group PA type 3
4000 atoms in group PA
group PB type 4
2000 atoms in group PB
group CM type 1 2
2000 atoms in group CM

# Neighbor list
neighbor ${r_cWCA} bin # extra-distance style
neighbor 1.12 bin 

# COMPUTES

# Compute global kinetic and potential energy and temperature
compute t all temp
compute p all pressure t
compute ep all pe
compute ek all ke
variable eT equal etotal
variable eB equal ebond
variable eA equal eangle
variable eM equal emol
variable ec equal ecouple
variable eC equal econserve

# Potencial energy per pair-wise interaction
compute wcaPair all pair lj/cut/omp epair
compute patchPair all pair table/omp epair
compute swapPair all pair threebody/table epair

# Compute the pressure
compute press all pressure t ke virial
compute pressVirial all pressure t virial
compute pressVirialMod all pressure t pair bond angle

# Computes for the stress
compute cstress all stress/atom t ke pair bond angle
compute cstressVirial all stress/atom t virial
compute cstressVirialMod all stress/atom t pair bond angle
compute stress all reduce sum c_cstress[*]
compute stressVirial all reduce sum c_cstressVirial[*]
compute stressVirialMod all reduce sum c_cstressVirialMod[*]

# Get the number of central particles per cluster
compute clusters all aggregate/atom ${r_cPP}                             # Create the clusters
compute clusters all aggregate/atom 0.6                             

# DUMPS and FIXES

thermo ${N_dump}
thermo 100000

# Save global energies and temperature
fix Energy all ave/time 1 ${N_save} ${N_save} c_t c_wcaPair c_patchPair c_swapPair c_ep c_ek v_eT v_ec v_eC c_p v_eB v_eA v_eM file ${Dir}/${file1_name}
fix Energy all ave/time 1 10000 ${N_save} c_t c_wcaPair c_patchPair c_swapPair c_ep c_ek v_eT v_ec v_eC c_p v_eB v_eA v_eM file ${Dir}/${file1_name}
fix Energy all ave/time 1 10000 10000 c_t c_wcaPair c_patchPair c_swapPair c_ep c_ek v_eT v_ec v_eC c_p v_eB v_eA v_eM file ${Dir}/${file1_name}
fix Energy all ave/time 1 10000 10000 c_t c_wcaPair c_patchPair c_swapPair c_ep c_ek v_eT v_ec v_eC c_p v_eB v_eA v_eM file /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/${file1_name}
fix Energy all ave/time 1 10000 10000 c_t c_wcaPair c_patchPair c_swapPair c_ep c_ek v_eT v_ec v_eC c_p v_eB v_eA v_eM file /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/system_assembly.fixf

# Save Pressure and Stress tensor
fix fixStress5 all ave/time 1 ${N_save} ${N_save} c_p c_press[*] c_pressVirial[*] c_pressVirialMod[*] c_stress[*] c_stressVirial[*] c_stressVirialMod[*] file ${Dir}/${file2_name}
fix fixStress5 all ave/time 1 10000 ${N_save} c_p c_press[*] c_pressVirial[*] c_pressVirialMod[*] c_stress[*] c_stressVirial[*] c_stressVirialMod[*] file ${Dir}/${file2_name}
fix fixStress5 all ave/time 1 10000 10000 c_p c_press[*] c_pressVirial[*] c_pressVirialMod[*] c_stress[*] c_stressVirial[*] c_stressVirialMod[*] file ${Dir}/${file2_name}
fix fixStress5 all ave/time 1 10000 10000 c_p c_press[*] c_pressVirial[*] c_pressVirialMod[*] c_stress[*] c_stressVirial[*] c_stressVirialMod[*] file /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/${file2_name}
fix fixStress5 all ave/time 1 10000 10000 c_p c_press[*] c_pressVirial[*] c_pressVirialMod[*] c_stress[*] c_stressVirial[*] c_stressVirialMod[*] file /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/stress_assembly.fixf

# Save atom positions with cluster id
dump dumpID all custom ${N_dump} ${Dir}/traj/${file3_name} id mol c_clusters type x y z vx vy vz
dump dumpID all custom 100000 ${Dir}/traj/${file3_name} id mol c_clusters type x y z vx vy vz
dump dumpID all custom 100000 /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/traj/${file3_name} id mol c_clusters type x y z vx vy vz
dump dumpID all custom 100000 /home/franvt/GitRepos/molDynLammps/polymericGels/gel-batch-3/data/2026-07-08-085719_1_phi0.01_chi0.5/traj/traj_assembly.*.dumpf id mol c_clusters type x y z vx vy vz
dump_modify dumpID pbc yes # remap atoms via periodic boundary conditions

# RUN SIMULATION

# Brownian Dynamics using Langevin Thermostat

timestep ${tstep}
timestep 0.002

fix VelVerlet all nve # Use Velocity Verlet integrator

# First elevate the temperature
fix ThermoLng all langevin 0.0 ${temp} ${damp} ${seed3} tally yes zero yes # Brownian Dynamics: langevin + nve
fix ThermoLng all langevin 0.0 0.05 ${damp} ${seed3} tally yes zero yes 
fix ThermoLng all langevin 0.0 0.05 1.0 ${seed3} tally yes zero yes 
fix ThermoLng all langevin 0.0 0.05 1.0 80 tally yes zero yes 
run ${N_heat}
run 500000
